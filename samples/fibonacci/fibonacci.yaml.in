apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${FIBONACCI_DEPLOYMENT_NAME}
spec:
  selector:
    matchLabels:
      app: ${FIBONACCI_DEPLOYMENT_NAME}
  template:
    metadata:
      labels:
        app: ${FIBONACCI_DEPLOYMENT_NAME}
    spec:
      containers:
        - name: fibonacci
          image: ${FIBONACCI_IMAGE_NAME}:${FIBONACCI_IMAGE_TAG}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
              protocol: TCP
          readinessProbe:
            tcpSocket:
              port: 8080
          resources:
            requests:
              cpu: 200m
            limits:
              cpu: 200m
---
apiVersion: v1
kind: Service
metadata:
  name: ${FIBONACCI_DEPLOYMENT_NAME}
spec:
  ports:
    - port: 80
      protocol: TCP
      targetPort: 8080
  selector:
    app: ${FIBONACCI_DEPLOYMENT_NAME}
  type: ClusterIP
