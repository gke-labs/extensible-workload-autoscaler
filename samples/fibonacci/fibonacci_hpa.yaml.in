apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: ${FIBONACCI_DEPLOYMENT_NAME}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: ${FIBONACCI_DEPLOYMENT_NAME}
  minReplicas: 3
  maxReplicas: 40
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 60
